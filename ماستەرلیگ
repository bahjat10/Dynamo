<html lang="ckb" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ماستەر لیگ</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#E9EFEA;--ink:#10231A;--grass:#1F6B43;--grass2:#1a5f3c;--gold:#C99A2E;--red:#C23B3B;--blue:#2F6FB0;--card:#fff;--line:#d3dcd5;--mute:#5d6f64}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Vazirmatn','Noto Sans Arabic','Segoe UI',Tahoma,sans-serif;padding-bottom:78px}
header{background:repeating-linear-gradient(90deg,var(--grass) 0 38px,var(--grass2) 38px 76px);color:#fff;padding:14px 16px 12px;border-bottom:4px solid #fff;box-shadow:0 0 0 1px var(--grass2)}
header h1{margin:0;font-size:18px;font-weight:800}
header .sub{display:flex;gap:14px;font-size:13px;margin-top:6px;opacity:.95;flex-wrap:wrap}
main{padding:12px;max-width:640px;margin:0 auto}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:12px}
.card h2{margin:0 0 8px;font-size:15px;font-weight:800}
.big{width:100%;border:0;background:var(--ink);color:#fff;font:inherit;font-weight:800;font-size:16px;padding:14px;border-radius:8px}
.big:active{background:var(--grass)}
.btn{border:1px solid var(--ink);background:#fff;color:var(--ink);font:inherit;font-size:12px;font-weight:600;padding:5px 9px;border-radius:6px}
.btn.buy{background:var(--grass);color:#fff;border-color:var(--grass)}
.btn.sell{background:var(--red);color:#fff;border-color:var(--red)}
.row{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.row .avw{width:40px;height:40px;border-radius:50%;overflow:hidden;flex:none;background:#dfe7e1}
.nm{flex:1;min-width:0}
.nm b{display:block;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nm small{color:var(--mute);font-size:11px}
.pos{width:30px;text-align:center;font-size:10px;font-weight:800;color:#fff;border-radius:4px;padding:3px 0;flex:none}
.pos.GK{background:var(--gold)}.pos.DF{background:var(--blue)}.pos.MF{background:#1F8A5B}.pos.FW{background:var(--red)}
.ovr{width:32px;text-align:center;font-weight:800;font-size:14px;padding:4px 0;border-radius:4px;color:#fff;flex:none}
.oa{background:var(--gold)}.ob{background:var(--grass)}.oc{background:#587a8f}.od{background:#8a948e}
.xi{border-right:3px solid var(--grass);padding-right:6px}
.meRow{background:#fff4d6}
.act{display:flex;gap:4px;align-items:center}
nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:2px solid var(--ink);z-index:5}
nav button{flex:1;border:0;background:none;font:inherit;font-size:12px;font-weight:600;padding:12px 2px;color:var(--mute)}
nav button.on{color:#fff;background:var(--ink)}
select,input{font:inherit;font-size:14px;padding:8px;border:1px solid var(--line);border-radius:6px;background:#fff;width:100%}
.filters{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}
.filters input{grid-column:1/3}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{padding:6px 3px;text-align:center;border-bottom:1px solid var(--line)}
td.t{text-align:right;font-weight:600}
tr.me{background:#fff4d6}
.res{display:flex;justify-content:space-between;gap:6px;padding:6px 0;border-bottom:1px solid var(--line);font-size:13px}
.res.me{font-weight:800;background:#fff4d6}
.res span:nth-child(2){font-weight:800;direction:ltr;min-width:44px;text-align:center}
.pick{display:flex;justify-content:space-between;align-items:center;width:100%;padding:12px;margin-bottom:6px;background:#fff;border:1px solid var(--line);border-radius:8px;font:inherit;text-align:right}
.pick small{color:var(--mute)}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.chip{border:1px solid var(--ink);background:#fff;border-radius:99px;padding:6px 12px;font:inherit;font-size:12px}
.chip.on{background:var(--ink);color:#fff}
.gold{background:linear-gradient(#fff,#fbf1d4);border-color:var(--gold)}
.award{font-size:13px;line-height:1.9}
.mute{color:var(--mute);font-size:12px}
#toast{position:fixed;top:12px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:8px;font-size:13px;z-index:30;opacity:0;transition:opacity .2s;pointer-events:none;max-width:90%;text-align:center}
#toast.on{opacity:1}
details summary{font-weight:800;font-size:14px}
.form{display:grid;gap:6px;margin-top:8px}
.sb{display:flex;align-items:center;justify-content:space-between;gap:6px;font-weight:800;font-size:14px}
.sb .sc{font-size:30px;direction:ltr}
.sb .tm{flex:1;text-align:center}
.dot{display:inline-block;width:22px;height:22px;border-radius:50%;vertical-align:middle;margin-left:4px}
.ev{font-size:13px;padding:3px 0}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center;margin:8px 0}
.grid3 b{display:block;font-size:20px}
.grid3 small{color:var(--mute);font-size:11px}
.bar{height:8px;background:#e4eae6;border-radius:4px;overflow:hidden;margin:6px 0}
.bar i{display:block;height:100%;background:var(--grass)}
#modal{position:fixed;inset:0;background:rgba(10,20,15,.72);display:none;align-items:center;justify-content:center;z-index:20;padding:16px}
#modal.on{display:flex}
.fc{width:100%;max-width:330px;border-radius:18px 18px 44px 44px;padding:16px 16px 16px;color:#2b2208;background:linear-gradient(160deg,#f4dc8a,#c99a2e 55%,#8a6a1c);box-shadow:0 10px 30px rgba(0,0,0,.4)}
.fc.s{background:linear-gradient(160deg,#eef2f4,#aeb9bf 55%,#7b878d);color:#1d2a30}
.fc.b{background:linear-gradient(160deg,#e9c9a4,#b07b45 55%,#7a4f26);color:#2a1808}
.fc .top{display:flex;justify-content:space-between;align-items:flex-start;gap:6px}
.fc .ovrbig{font-size:38px;font-weight:800;line-height:1}
.fc .avc{width:128px;height:128px;border-radius:50%;overflow:hidden;background:rgba(255,255,255,.35);flex:none}
.fc .name{text-align:center;font-weight:800;font-size:18px;border-bottom:1px solid rgba(0,0,0,.25);padding-bottom:6px;margin:8px 0}
.fc .st{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px 10px;direction:ltr;text-align:center;font-weight:800;font-size:18px}
.fc .st small{font-weight:600;display:block;font-size:10px}
.fc .foot{text-align:center;font-size:12px;font-weight:700;margin:10px 0 8px}
.fc .acts{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
.bigbtn{margin-bottom:8px}
</style>
