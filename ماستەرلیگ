function buy(id){if(isP())return;const p=P(id),pr=val(p);
if(S.budget<pr)return toast(‘پارەکەت بەس نییە’);
if(mine().length>=MAXSQ)return toast(‘تیمەکەت پڕە (زۆرترین ‘+MAXSQ+’)’);
const from=T(p.t);mkP(from,p.p,clamp(p.o-R(6,12),48,80),R(19,30));
p.t=S.user;S.budget=Math.round((S.budget-pr)*10)/10;MEMO={};toast(p.n+’ کڕدرا’);save();closeCard();render()}
function sell(id){if(isP())return;const p=P(id);const cnt=mine().filter(x=>x.p==p.p).length;
if(mine().length<=16)return toast(‘تیمەکەت لەوە کەمتر نابێت (١٦)’);
if(cnt<=MIN[p.p])return toast(‘پێویستت بە ‘+MIN[p.p]+’ ‘+POSK[p.p]+’ هەیە’);
const pr=Math.round(val(p)*9)/10;
if(!confirm(p.n+’ بفرۆشرێت بە ‘+money(pr)+’؟’))return;
const to=pick(S.teams.filter(t=>t.id!=S.user));
const low=S.players.filter(x=>x.t==to.id&&x.p==p.p&&x!==p).sort((a,b)=>a.o-b.o)[0];
if(low&&!low.me)S.players.splice(S.players.indexOf(low),1);
p.t=to.id;S.budget=Math.round((S.budget+pr)*10)/10;MEMO={};toast(p.n+’ فرۆشرا’);save();closeCard();render()}
function edit(id){const p=P(id);const v=prompt(‘ئاستی نوێی ‘+p.n+’ (٤٠ - ٩٩)’,p.o);if(v==null)return;
p.o=clamp(parseInt(v)||p.o,40,99);MEMO={};save();render();card(id)}
