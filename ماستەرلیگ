function stats(p){const o=p.o,gk=p.p==‘GK’;
const off=gk?[0,0,-4,1,-14,-2]:{FW:[2,4,0,2,-18,-4],MF:[-2,-6,3,1,-8,-2],DF:[-3,-18,-4,-8,5,4]}[p.p];
return off.map((d,i)=>{let v=o+d+(hh(p.id*13+i)%9)-4;if(i==0&&p.a>30)v-=(p.a-30)*1.5;return clamp(Math.round(v),25,99)})}

function genName(nat){const [f,l]=NAMES[nat];return pick(f)+’ ‘+pick(l)}
function mkP(t,pos,o,a,n){const p={id:S.nid++,n:n||genName(natOf(t)),p:pos,a:a,o:Math.round(o),t:t.id,g:0,as:0};S.players.push(p);return p}
function dropLowest(tid,pos){const g=S.players.filter(p=>p.t==tid&&p.p==pos&&!p.star&&!p.me).sort((a,b)=>a.o-b.o)[0];if(g)S.players.splice(S.players.indexOf(g),1)}
function genSquad(t,st){
const comp={GK:3,DF:7,MF:7,FW:5};
for(const pos in comp)for(let i=0;i<comp[pos];i++)mkP(t,pos,clamp(t.s+R(-13,3),45,80),Math.round((R(18,34)+R(18,36))/2));
if(st)st.split(’;’).forEach(x=>{const [n,pos,a,o]=x.split(’,’);dropLowest(t.id,pos);const q=mkP(t,pos,+o,+a,n);q.star=1;if(n==‘Bahjat’)q.bj=1});
}
function rr(ids){const n=ids.length;let a=ids.slice();const rounds=[];
for(let r=0;r<n-1;r++){const m=[];for(let i=0;i<n/2;i++){const h=a[i],b=a[n-1-i];m.push(r%2?[b,h]:[h,b])}
rounds.push(m);a=[a[0],a[n-1],…a.slice(1,n-1)]}
return rounds.concat(rounds.map(m=>m.map(([h,b])=>[b,h])))}
function buildFixtures(){S.fx={};LEAGUES.forEach(l=>{const ids=S.teams.filter(t=>t.l==l.id).map(t=>t.id).sort(()=>Math.random()-.5);S.fx[l.id]=rr(ids)})}
function newWorld(){
S={teams:[],players:[],nid:1,season:2026,week:0,fx:{},last:null,hist:[],user:null,mode:null,me:null,pot:85,xp:0,train:2,offers:null,over:false,budget:0};
TD.forEach(([l,n,s,st],i)=>{const t={id:i,n,l,s,pts:0,w:0,d:0,lo:0,gf:0,ga:0};S.teams.push(t);genSquad(t,st)});
buildFixtures();
}
function val(p){const b=Math.pow(Math.max(p.o-50,1),2.6)/60;const f=p.a<=21?1.4:p.a<=25?1.15:p.a<=29?1:p.a<=32?.6:.3;return Math.max(.2,Math.round(b*f*10)/10)}
function str(id){if(MEMO[id]!=null)return MEMO[id];
const sq=S.players.filter(p=>p.t==id);const top=(pos,n)=>sq.filter(p=>p.p==pos).sort((a,b)=>b.o-a.o).slice(0,n).map(p=>p.o);
const x=[…top(‘GK’,1),…top(‘DF’,4),…top(‘MF’,3),…top(‘FW’,3)];
return MEMO[id]=x.reduce((a,b)=>a+b,0)/Math.max(x.length,1)}
function xiIds(id){const sq=S.players.filter(p=>p.t==id);const s=new Set();
[[‘GK’,1],[‘DF’,4],[‘MF’,3],[‘FW’,3]].forEach(([pos,n])=>sq.filter(p=>p.p==pos).sort((a,b)=>b.o-a.o).slice(0,n).forEach(p=>s.add(p.id)));return s}
function pois(l){const L=Math.exp(-l);let k=0,p=1;do{k++;p*=Math.random()}while(p>L);return Math.min(k-1,8)}
function sim(h,a){const sh=str(h),sa=str(a);return [pois(1.45*Math.exp((sh-sa)/20)),pois(1.1*Math.exp((sa-sh)/20))]}
function pickW(t,kind,ex){
const sq=S.players.filter(p=>p.t==t&&p!==ex),xi=XI[t]||(XI[t]=xiIds(t));
const W=kind==‘g’?{FW:6,MF:2.5,DF:.7,GK:.02}:{FW:3,MF:4,DF:1.2,GK:.05};
const ws=sq.map(p=>W[p.p]*Math.pow(p.o/70,4)*(xi.has(p.id)?1:.12));const tot=ws.reduce((a,b)=>a+b,0);let r=Math.random()*tot;
for(let i=0;i<sq.length;i++){r-=ws[i];if(r<=0)return sq[i]}return sq[0]}
function record(h,a,gh,ga){
const H=T(h),A=T(a);H.gf+=gh;H.ga+=ga;A.gf+=ga;A.ga+=gh;
if(gh>ga){H.pts+=3;H.w++;A.lo++}else if(gh<ga){A.pts+=3;A.w++;H.lo++}else{H.pts++;A.pts++;H.d++;A.d++}
const ev=[];[[h,gh],[a,ga]].forEach(([t,n])=>{for(let i=0;i<n;i++){const s=pickW(t,‘g’);s.g++;let as=null;
if(Math.random()<.7){as=pickW(t,‘a’,s);if(as)as.as++}ev.push({t,s:s.n,a:as?as.n:null,m:R(1,90)})}});
return ev}
function table(l){return S.teams.filter(t=>t.l==l).sort((a,b)=>b.pts-a.pts||(b.gf-b.ga)-(a.gf-a.ga)||b.gf-a.gf)}

function playWeek(){
if(S.over)return;
MEMO={};XI={};const w=S.week,L=T(S.user).l,last={w:w+1,ms:[],um:null,ev:[],me:null};
const m0=isP()?P(S.me):null,g0=m0?m0.g:0,a0=m0?m0.as:0,st0=m0?xiIds(S.user).has(m0.id):false;
LEAGUES.forEach(l=>S.fx[l.id][w].forEach(([h,a])=>{const [gh,ga]=sim(h,a);const ev=record(h,a,gh,ga);
if(l.id==L){last.ms.push({h,a,gh,ga});if(h==S.user||a==S.user){last.um={h,a,gh,ga};last.ev=ev.sort((x,y)=>x.m-y.m)}}}));
if(m0){const scored=m0.g>g0||m0.as>a0;if(st0||scored||Math.random()<.35)m0.ap=(m0.ap||0)+1;
last.me={st:st0,g:m0.g-g0,a:m0.as-a0};S.xp+=S.train;
while(S.xp>=10){S.xp-=10;m0.o=Math.min(S.pot,m0.o+1)}}
S.last=last;S.week++;
if(S.week>=ROUNDS){endSeason();TAB=‘awards’;toast(‘وەرز تەواو بوو! خەڵاتەکان بزانە’)}
save();render()}

function makeOffers(){const m=P(S.me);
S.offers=S.teams.filter(t=>t.id!=m.t).map(t=>({id:t.id,s:Math.abs(str(t.id)-m.o-4)+Math.random()*8})).sort((a,b)=>a.s-b.s).slice(0,3).map(x=>x.id)}
function acceptOffer(tid){const m=P(S.me);dropLowest(tid,m.p);m.t=tid;S.user=tid;S.offers=null;TL=T(tid).l;MEMO={};
toast(’چوویتە ’+T(tid).n);save();render()}
function requestOffers(){MEMO={};makeOffers();save();render()}

function endSeason(){
const rank={},champs=[];
LEAGUES.forEach(l=>{const tb=table(l.id);tb.forEach((t,i)=>rank[t.id]=i+1);champs.push({l:l.name,t:tb[0].n})});
const nm=p=>({n:p.n,t:T(p.t).n,g:p.g,as:p.as,o:p.o,me:!!p.me});
const sc=S.players.map(p=>({p,s:p.o+p.g*1.3+p.as*.8+(rank[p.t]==1?7:rank[p.t]<=3?3:0)+Math.random()*3}));
const best=arr=>arr.slice().sort((a,b)=>b.s-a.s);
const bd=best(sc).slice(0,3).map(x=>nm(x.p));
const boot=S.players.slice().sort((a,b)=>b.g-a.g)[0],ast=S.players.slice().sort((a,b)=>b.as-a.as)[0];
const yg=best(sc.filter(x=>x.p.a<=21))[0],gk=best(sc.filter(x=>x.p.p==‘GK’))[0];
const h={y:S.season,bd,boot:nm(boot),ast:nm(ast),yg:yg&&nm(yg.p),gk:gk&&nm(gk.p),champs,ur:rank[S.user],ut:T(S.user).n,ret:[],gain:0};
if(isP()){const m=P(S.me);h.my={o:m.o,g:m.g,as:m.as,ap:m.ap||0};m.cg=(m.cg||0)+m.g;m.cas=(m.cas||0)+m.as;m.cap=(m.cap||0)+(m.ap||0);m.ap=0;m.bd=(m.bd||0)+(bd[0].me?1:0)}
else{const gain=15+(8-rank[S.user])*3+(rank[S.user]==1?10:0);S.budget=Math.round((S.budget+gain)*10)/10;h.gain=gain}
const retired=[];
S.players.forEach(p=>{p.a++;const d=p.a<=21?R(1,4):p.a<=24?R(0,3):p.a<=29?R(-1,1):p.a<=33?R(-3,0):R(-4,-1);
p.o=clamp(p.o+(p.bj&&p.a<=24?R(2,5):d),40,p.bj?97:95);if(p.me)p.o=Math.min(p.o,S.pot);p.g=0;p.as=0;
if(!p.me&&(p.a>=37||(p.a>=35&&p.o<60)))retired.push(p)});
retired.forEach(p=>{S.players.splice(S.players.indexOf(p),1);const t=T(p.t);
if(p.t==S.user)h.ret.push(p.n);
mkP(t,p.p,clamp(t.s-8+R(-5,5),50,75),R(18,20))});
S.hist.unshift(h);
S.teams.forEach(t=>{t.pts=t.w=t.d=t.lo=t.gf=t.ga=0});
S.season++;S.week=0;MEMO={};buildFixtures();
if(isP()){const m=P(S.me);if(m.a>=38)S.over=true;else makeOffers()}}

