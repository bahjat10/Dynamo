if(!n)return toast(‘ناوی یاریزان بنووسە’);const p=mkP(T(t),pos,o,a,n);p.star=1;MEMO={};toast(‘زیادکرا’);save();render()}
function pickTeam(id){const t=T(id);
if(START.mode==‘player’&&!START.name.trim())return toast(‘سەرەتا ناوی یاریزانەکەت بنووسە’);
if(!confirm(‘دەتەوێت لەگەڵ ‘+t.n+’ دەست پێبکەیت؟’))return;
S.mode=START.mode;S.user=id;TAB=‘home’;PL=t.l;TL=t.l;
if(S.mode==‘player’){dropLowest(id,START.pos);const p=mkP(t,START.pos,60+R(0,5),18,START.name.trim());p.me=1;p.ap=0;
S.me=p.id;S.pot=R(82,93);S.xp=0;S.train=2;S.budget=0;MEMO={}}
else S.budget=Math.max(20,Math.round(20+(t.s-58)*5));
save();render()}
function resetAll(){if(!confirm(‘هەموو شتێک دەسڕدرێتەوە و لە سەرەتا دەست پێدەکەیتەوە. دڵنیایت؟’))return;
try{localStorage.removeItem(‘ml_save_v2’)}catch(e){}START={mode:null,name:’’,pos:‘FW’};TAB=‘home’;newWorld();render()}
function setTrain(n){S.train=n;save();render()}

// ––––– کارتی یاریزان –––––
function card(id){const p=P(id);if(!p)return;const t=T(p.t),st=stats(p),gk=p.p==‘GK’;
const L=gk?[‘DIV’,‘HAN’,‘KIC’,‘REF’,‘SPD’,‘POS’]:[‘PAC’,‘SHO’,‘PAS’,‘DRI’,‘DEF’,‘PHY’];
const cls=p.o>=85?’’:p.o>=76?‘s’:‘b’;let acts=’’;
if(!isP()){acts+=p.t==S.user?`<button class="btn sell" onclick="sell(${p.id})">فرۆشتن ${money(Math.round(val(p)*9)/10)}</button>`:`<button class="btn buy" onclick="buy(${p.id})">کڕین ${money(val(p))}</button>`}
acts+=`<button class="btn" onclick="edit(${p.id})">گۆڕینی ئاست</button><button class="btn" onclick="editImg(${p.id})">وێنە</button>`;
$(’#modal’).innerHTML=`<div class="fc ${cls}" onclick="event.stopPropagation()"><div class="top"><div><div class="ovrbig">${p.o}</div><b>${p.p}</b></div><div class="avc">${avatar(p,128)}</div><div style="text-align:left;font-size:12px;font-weight:700">${esc(t.n)}<br>${p.a} ساڵ</div></div>

 <div class="name">${esc(p.n)}${p.me?' ⭐':''}</div><div class="st">${st.map((v,i)=>`<div>${v}<small>${L[i]}</small></div>`).join('')}</div>
 <div class="foot">${money(val(p))} · ⚽ ${p.g} · 🎯 ${p.as}</div><div class="acts">${acts}</div></div>`;
 $('#modal').classList.add('on')}
function closeCard(){$('#modal').classList.remove('on')}

// ––––– ڕووکار –––––
const prow=(p,btns,sub,xi)=>`<div class="row ${xi?'xi':''} ${p.me?'meRow':''}" onclick="card(${p.id})"><div class="avw">${avatar(p,40)}</div><span class="pos ${p.p}">${p.p}</span><div class="nm"><b>${esc(p.n)}${p.me?' ⭐':''}</b><small>${p.a} ساڵ · ${sub}</small></div><span class="ovr o${tier(p.o)}">${p.o}</span><div class="act" onclick="event.stopPropagation()">${btns}</div></div>`;

function vPick(){
$(’#h1’).textContent=‘ماستەر لیگ’;$(’#hsub’).textContent=’’;$(’#nav’).innerHTML=’’;
if(!START.mode)return `<div class="card"><h2>چۆن دەتەوێت یاری بکەیت؟</h2><button class="big bigbtn" onclick="START.mode='manager';render()">بەڕێوەبەری تیم (Master League)</button><button class="big" onclick="START.mode='player';render()">یاریزان (Be a Legend)</button></div>`;
let top=`<button class="btn" style="margin-bottom:10px" onclick="START.mode=null;render()">گەڕانەوە</button>`;
if(START.mode==‘player’)top+=`<div class="card"><h2>یاریزانەکەت دروست بکە</h2><div class="form"><input placeholder="ناوی تۆ" value="${esc(START.name)}" oninput="START.name=this.value"><select onchange="START.pos=this.value">${posOptions(START.pos)}</select><div class="mute">لە تەمەنی ١٨ ساڵی و ئاستی نزمەوە دەست پێدەکەیت. ئێستا کڵوبێک هەڵبژێرە، دەتوانیت ڕیال مەدرید هەڵبژێریت.</div></div></div>`;
const chips=LEAGUES.map(l=>`<button class="chip ${l.id==PL?'on':''}" onclick="PL='${l.id}';render()">${l.name}</button>`).join(’’);
const teams=S.teams.filter(t=>t.l==PL).map(t=>`<button class="pick" onclick="pickTeam(${t.id})"><b>${esc(t.n)}</b><small>هێز ${Math.round(str(t.id))}${START.mode=='manager'?' · بودجە '+money(Math.max(20,Math.round(20+(t.s-58)*5))):''}</small></button>`).join(’’);
return `${top}<div class="chips">${chips}</div>${teams}`}

function vHome(){
const t=T(S.user),tb=table(t.l),rk=tb.indexOf(t)+1,lg=LEAGUES.find(l=>l.id==t.l);
let out=’’;
if(S.over){const m=P(S.me);out+=`<div class="card gold"><h2>کارەکەت وەک یاریزان تەواو بوو</h2><div class="grid3"><div><b>${m.cg||0}</b><small>گۆڵ</small></div><div><b>${m.cas||0}</b><small>ئاسیست</small></div><div><b>${m.bd||0}</b><small>بالۆن دۆر</small></div></div><div class="mute">ئاستی کۆتایی ${m.o} · ${m.cap||0} یاری</div></div>`}
else{const fx=S.fx[t.l][S.week].find(m=>m[0]==S.user||m[1]==S.user),home=fx[0]==S.user,opp=T(home?fx[1]:fx[0]),ka=kit(T(fx[0])),kb=kit(T(fx[1]));
out+=`<div class="card gold"><h2>هەفتەی ${S.week+1} لە ${ROUNDS}</h2>

  <div class="sb"><div class="tm"><i class="dot" style="background:${ka[0]};border:3px solid ${ka[1]}"></i>${esc(T(fx[0]).n)}</div><div class="mute">دژی</div><div class="tm"><i class="dot" style="background:${kb[0]};border:3px solid ${kb[1]}"></i>${esc(T(fx[1]).n)}</div></div>
  <div class="mute" style="margin-top:6px">هێزی تۆ ${Math.round(str(t.id))} · هێزی ${esc(opp.n)} ${Math.round(str(opp.id))}</div>
  <button class="big" style="margin-top:10px" onclick="playWeek()">یاری هەفتە بکە</button></div>`}
 if(isP()){const m=P(S.me),xi=xiIds(S.user).has(m.id);
  out+=`<div class="card"><h2>${esc(m.n)} ⭐</h2><div class="row" style="border:0"><div class="avw" style="width:64px;height:64px">${avatar(m,64)}</div><div class="nm"><b>${esc(t.n)}</b><small>${POSK[m.p]} · ${m.a} ساڵ · ${xi?'یازدەی سەرەکی':'یەدەگ'}</small></div><span class="ovr o${tier(m.o)}" onclick="card(${m.id})">${m.o}</span></div>
  <div class="grid3"><div><b>${m.g}</b><small>گۆڵ</small></div><div><b>${m.as}</b><small>ئاسیست</small></div><div><b>${m.ap||0}</b><small>یاری</small></div></div>
  <div class="mute">ڕاهێنان (هەفتانە): پێشکەوتن ${S.xp}/10 · توانای بەرزترین ${S.pot}</div><div class="bar"><i style="width:${S.xp*10}%"></i></div>
  <div class="chips">${[[1,'سووک'],[2,'ناوەند'],[3,'قورس']].map(([n,l])=>`<button class="chip ${S.train==n?'on':''}" onclick="setTrain(${n})">${l}</button>`).join('')}</div>
  ${xi?'':'<div class="mute">لە یەدەگیت. ئاستت بەرز بکەرەوە یان بچۆ بۆ کڵوبێکی بچووکتر بۆ یاری زیاتر.</div>'}</div>`;
  if(!S.over){out+=`<div class="card"><h2>پێشنیارەکانی گواستنەوە</h2>`;
   if(S.offers&&S.offers.length)out+=S.offers.map(id=>`<div class="row"><div class="nm"><b>${esc(T(id).n)}</b><small>${LEAGUES.find(l=>l.id==T(id).l).name} · هێز ${Math.round(str(id))}</small></div><button class="btn buy" onclick="acceptOffer(${id})">قبوڵ بکە</button></div>`).join('');
   else out+='<div class="mute">پێشنیار نییە.</div>';
   out+=`<button class="btn" style="margin-top:8px" onclick="requestOffers()">داوای پێشنیاری نوێ</button></div>`}}
 out+=`<div class="card"><h2>${lg.name}</h2><div>پلەی ${rk} · ${t.pts} خاڵ</div></div>`;
 if(S.last){const u=S.last.um;
  if(u){out+=`<div class="card"><h2>یاری هەفتەی ${S.last.w}</h2><div class="sb"><div class="tm">${esc(T(u.h).n)}</div><div class="sc">${u.gh} - ${u.ga}</div><div class="tm">${esc(T(u.a).n)}</div></div><div style="margin-top:8px">`
   +(S.last.ev.length?S.last.ev.map(e=>`<div class="ev">${e.m}' ⚽ <b>${esc(e.s)}</b> <span class="mute">${esc(T(e.t).n)}${e.a?' · ئاسیست: '+esc(e.a):''}</span></div>`).join(''):'<div class="mute">گۆڵ نەبوو</div>')+'</div>';
   if(S.last.me){const lm=S.last.me;out+=`<div class="mute" style="margin-top:8px">تۆ: ${lm.st?'یازدەی سەرەکی':'یەدەگ'}${lm.g?' · '+lm.g+' گۆڵ':''}${lm.a?' · '+lm.a+' ئاسیست':''}</div>`}
   out+='</div>'}
  out+=`<div class="card"><h2>ئەنجامەکانی ${lg.name}</h2>`+S.last.ms.map(m=>`<div class="res ${(m.h==S.user||m.a==S.user)?'me':''}"><span>${esc(T(m.h).n)}</span><span>${m.gh} - ${m.ga}</span><span>${esc(T(m.a).n)}</span></div>`).join('')+'</div>'}
 out+=`<button class="btn" onclick="resetAll()">دەستپێکردنەوە لە سەرەتا</button>`;return out}

function vSquad(){
const xi=xiIds(S.user),sq=mine().sort((a,b)=>POSORD(a.p)-POSORD(b.p)||b.o-a.o);
return `<div class="card"><h2>یاریزانەکان (${sq.length})</h2><div class="mute">هێڵی سەوز = یازدەی سەرەکی · کلیک لە یاریزان بکە بۆ کارت</div>`+
sq.map(p=>prow(p,isP()?’’:`<button class="btn sell" onclick="sell(${p.id})">${money(Math.round(val(p)*9)/10)}</button>`,`⚽ ${p.g} · ئاسیست ${p.as}`,xi.has(p.id))).join(’’)+’</div>’}

function mList(){
let r=S.players.filter(p=>p.t!=S.user);
if(MK.l!=‘all’)r=r.filter(p=>T(p.t).l==MK.l);
if(MK.pos!=‘all’)r=r.filter(p=>p.p==MK.pos);
if(MK.q)r=r.filter(p=>p.n.toLowerCase().includes(MK.q.toLowerCase()));
r=r.sort((a,b)=>b.o-a.o).slice(0,40);
return r.length?r.map(p=>prow(p,`<button class="btn buy" onclick="buy(${p.id})">${money(val(p))}</button>`,esc(T(p.t).n))).join(’’):’<div class="mute">هیچ یاریزانێک نەدۆزرایەوە</div>’}
function vMarket(){
const lo=’<option value="all">هەموو خولەکان</option>’+LEAGUES.map(l=>`<option value="${l.id}" ${MK.l==l.id?'selected':''}>${l.name}</option>`).join(’’);
const po=’<option value="all">هەموو پۆستەکان</option>’+posOptions(MK.pos);
const to=LEAGUES.map(l=>`<optgroup label="${l.name}">`+S.teams.filter(t=>t.l==l.id).map(t=>`<option value="${t.id}">${esc(t.n)}</option>`).join(’’)+’</optgroup>’).join(’’);
return `<div class="card"><h2>بازاڕی گواستنەوە</h2><div class="filters"><select onchange="MK.l=this.value;$('#ml').innerHTML=mList()">${lo}</select><select onchange="MK.pos=this.value;$('#ml').innerHTML=mList()">${po}</select><input placeholder="گەڕان بە ناو..." value="${esc(MK.q)}" oninput="MK.q=this.value;$('#ml').innerHTML=mList()"></div><div id="ml">${mList()}</div></div>

 <details class="card"><summary>یاریزانێکی نوێ زیاد بکە</summary><div class="form"><input id="an" placeholder="ناو"><select id="ap">${posOptions('FW')}</select><input id="aa" type="number" placeholder="تەمەن"><input id="ao" type="number" placeholder="ئاست (٤٠-٩٩)"><select id="at">${to}</select><button class="big" onclick="addPlayer()">زیادکردن</button></div></details>`}

function vTable(){
const lid=TL||T(S.user).l;
const chips=LEAGUES.map(l=>`<button class="chip ${l.id==lid?'on':''}" onclick="TL='${l.id}';render()">${l.name}</button>`).join(’’);
const rows=table(lid).map((t,i)=>`<tr class="${t.id==S.user?'me':''}"><td>${i+1}</td><td class="t">${esc(t.n)}</td><td>${t.w+t.d+t.lo}</td><td>${t.w}</td><td>${t.d}</td><td>${t.lo}</td><td style="direction:ltr">${t.gf-t.ga}</td><td><b>${t.pts}</b></td></tr>`).join(’’);
return `<div class="chips">${chips}</div><div class="card"><table><tr><th>#</th><th>تیم</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GD</th><th>Pts</th></tr>${rows}</table></div>`}

function vAwards(){
const sc=S.players.slice().sort((a,b)=>b.g-a.g||b.as-a.as).slice(0,5);
let out=`<div class="card"><h2>باشترین گۆڵکارەکانی ئێستا</h2>`+sc.map(p=>`<div class="res"><span>${esc(p.n)} <small class="mute">${esc(T(p.t).n)}</small></span><span>⚽ ${p.g}</span></div>`).join(’’)+’</div>’;
if(!S.hist.length)out+=’<div class="card mute">دوای تەواوبوونی وەرز، خەڵاتەکان لێرە دەردەکەون.</div>’;
S.hist.forEach(h=>{
const mine3=h.bd.findIndex(x=>x.me);
out+=`<div class="card gold award"><h2>وەرزی ${h.y}</h2> ${mine3==0?'🎉 <b>تۆ بالۆن دۆرت بردەوە!</b><br>':mine3>0?'تۆ لە پلەی '+(mine3+1)+'ی بالۆن دۆر بووی<br>':''} 🏆 <b>بالۆن دۆر:</b> ${esc(h.bd[0].n)} (${esc(h.bd[0].t)}) — ${h.bd[0].g} گۆڵ<br> <span class="mute">٢: ${esc(h.bd[1].n)} · ٣: ${esc(h.bd[2].n)}</span><br> 👟 <b>پێڵاوی زێڕین:</b> ${esc(h.boot.n)} (${h.boot.g} گۆڵ)<br> 🎯 <b>زۆرترین ئاسیست:</b> ${esc(h.ast.n)} (${h.ast.as})<br> ${h.yg?`🌟 <b>باشترین گەنج:</b> ${esc(h.yg.n)} (${esc(h.yg.t)})<br>`:''} ${h.gk?`🧤 <b>باشترین پارێزەر:</b> ${esc(h.gk.n)} (${esc(h.gk.t)})<br>`:''} <b>پاڵەوانی خولەکان:</b> ${h.champs.map(c=>esc(c.l)+': '+esc(c.t)).join(' · ')}<br> <b>${esc(h.ut)}:</b> پلەی ${h.ur}${h.gain?' · داهات '+money(h.gain):''}${h.my?'<br><b>تۆ:</b> ئاست '+h.my.o+' · '+h.my.g+' گۆڵ · '+h.my.as+' ئاسیست · '+h.my.ap+' یاری':''}${h.ret&&h.ret.length?'<br>پاشەکشەیان کرد: '+h.ret.map(esc).join('، '):''}</div>`});
return out}

function render(){
if(!S)return;
if(S.user==null){$(’#app’).innerHTML=vPick();return}
const t=T(S.user);$(’#h1’).textContent=t.n;
$(’#hsub’).innerHTML=`<span>وەرزی ${S.season}</span>`+(isP()?`<span>ئاستی تۆ ${P(S.me).o}</span>`:`<span>بودجە ${money(S.budget)}</span>`);
const tabs=[[‘home’,‘سەرەکی’],[‘squad’,‘تیم’]];if(!isP())tabs.push([‘market’,‘بازاڕ’]);tabs.push([‘table’,‘خشتە’],[‘awards’,‘خەڵات’]);
if(TAB==‘market’&&isP())TAB=‘home’;
$(’#nav’).innerHTML=tabs.map(([k,n])=>`<button class="${k==TAB?'on':''}" onclick="TAB='${k}';render();scrollTo(0,0)">${n}</button>`).join(’’);
const v={home:vHome,squad:vSquad,market:vMarket,table:vTable,awards:vAwards}[TAB];
$(’#app’).innerHTML=v()}

function ensureBahjat(){
if(S.players.some(p=>p.bj))return;
const rm=S.teams.find(t=>t.n==‘Real Madrid’);if(!rm)return;
dropLowest(rm.id,‘MF’);const p=mkP(rm,‘MF’,80,18,‘Bahjat’);p.star=1;p.bj=1;save()}
load();if(!S)newWorld();ensureBahjat();render();
</script>

</body>
</html>
